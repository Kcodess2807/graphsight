# Base URL of the TraceRAG FastAPI backend.
# Defaults to http://localhost:8000 when unset.
VITE_API_BASE=http://localhost:8000

# Clerk publishable key (Clerk Dashboard → API Keys → "Publishable key").
# Looks like pk_test_… or pk_live_…. Leave unset to run without auth.
VITE_CLERK_PUBLISHABLE_KEY=

# Sentry browser monitoring (optional; unset = disabled). Use the *frontend*
# project DSN — a separate Sentry project from the backend.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1   # dev=1.0; scale down in prod

# Waitlist signup target. Any service that accepts a JSON POST of { email, source }.
#   Formspree: https://formspree.io/f/<form-id>
#   Loops:     https://app.loops.so/api/newsletter-form/<form-id>
# Leave unset and the form refuses to claim success — it shows an error and, if
# VITE_CONTACT_EMAIL is set, offers a mailto instead of silently dropping the address.
VITE_WAITLIST_ENDPOINT=

# Shown as a "email us instead" fallback when the waitlist endpoint is unset.
VITE_CONTACT_EMAIL=
