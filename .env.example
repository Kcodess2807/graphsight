# Environment template for `docker compose up`. Copy to .env and fill in.
# The real .env is gitignored. Values after `=` are defaults.

# ---- Postgres (chat history) -----------------------------------------
POSTGRES_PASSWORD=tracerag

# ---- GitHub ingestion ------------------------------------------------
# A PAT (public-repo read is enough) to escape the 60 req/hour
# unauthenticated rate limit in scripts/ingest_github.py.
GITHUB_TOKEN=

# ---- LLMs ------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_key_here
# OPENROUTER_MODEL=anthropic/claude-3-haiku
GROQ_API_KEY=                 # query intent classification (optional)

# ---- Auth (Clerk) ----------------------------------------------------
# Set to enforce real auth; unset = dev-bypass (do NOT deploy unset).
CLERK_ISSUER=

# ---- Frontend / CORS -------------------------------------------------
CORS_ORIGINS=*                # lock to your frontend origin in production

# ---- Observability (optional) ---------------------------------------
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
